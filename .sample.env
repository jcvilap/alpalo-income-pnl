# =============================================================================
# alpalo-income-pnl — environment configuration
# =============================================================================
# This project READS Schwab transactions using the SAME Schwab app credentials
# and the SAME Redis instance as the sibling project `alpalo-v2`. Because
# alpalo-v2 already refreshes the Schwab OAuth tokens on a daily cron and stores
# them in Redis, this project can read valid tokens directly. Point the values
# below at the exact same values you use in alpalo-v2.
# =============================================================================

# -----------------------------------------------------------------------------
# REDIS (token store + transaction cache) — MUST match alpalo-v2's REDIS_URL
# Format: redis://[user:password@]host:port  (use rediss:// for TLS)
# -----------------------------------------------------------------------------
REDIS_URL=your_redis_url_here

# -----------------------------------------------------------------------------
# SCHWAB ACCOUNT(S) — MUST match alpalo-v2's ACCOUNTS (Schwab entry)
#   key          = Schwab App Client ID     (from developer.schwab.com)
#   secret       = Schwab App Client Secret
#   accessToken  = OAuth2 access token       (seeded once, auto-refreshed)
#   refreshToken = OAuth2 refresh token      (valid 7 days, rotates on refresh)
#   accountIdKey = Schwab encrypted account hash (optional; auto-resolved if omitted)
# -----------------------------------------------------------------------------
ACCOUNTS='[{"name":"Schwab Live","key":"YOUR_SCHWAB_CLIENT_ID","secret":"YOUR_SCHWAB_CLIENT_SECRET","isPaper":false,"broker":"Schwab","accessToken":"YOUR_ACCESS_TOKEN","refreshToken":"YOUR_REFRESH_TOKEN","accountIdKey":"YOUR_ACCOUNT_HASH"}]'

# -----------------------------------------------------------------------------
# CRON SECRET — protects the /api/cron/token-renew endpoint on Vercel.
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically when set.
# -----------------------------------------------------------------------------
CRON_SECRET=generate_a_long_random_string

# -----------------------------------------------------------------------------
# DASHBOARD LOGIN — checked server-side by /api/login (see LoginGate.tsx).
# This is a screen-privacy speed bump, not real authentication — the API
# routes underneath remain unauthenticated either way. Required in any
# non-localhost deployment (e.g. Vercel); the speed bump is skipped entirely
# on localhost.
# -----------------------------------------------------------------------------
DASHBOARD_USERNAME=your_username_here
DASHBOARD_PASSWORD=your_password_here
